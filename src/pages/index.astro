---
import EditorCV from "../components/EditorCV";
import PreviewCV from "../components/PreviewCV";
import ValidationHints from "../components/ValidationHints";
import AppHeader from "../components/AppHeader";
import EditorIntro from "../components/EditorIntro";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>CV Creator - MVP</title>

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("cvcreator-theme");
        if (stored === "dark") document.documentElement.classList.add("dark");
        else document.documentElement.classList.remove("dark");
      })();
    </script>
  </head>

  <body
    class="bg-background text-foreground min-h-screen transition-colors duration-300"
  >
    <AppHeader client:load />
    <main class="mx-auto flex min-h-[calc(100vh-64px)] w-full max-w-[1440px] flex-col px-5 pb-6 sm:px-8">
      <EditorIntro />

      <div class="grid flex-1 grid-cols-1 gap-6 lg:min-h-[430px] lg:grid-cols-2 lg:gap-6">
        <section class="flex min-h-[58vh] flex-col lg:min-h-0">
          <EditorCV client:load />
        </section>
        <section class="flex min-h-[58vh] flex-col lg:min-h-0">
          <PreviewCV client:load />
        </section>
      </div>

      <footer class="mt-5 flex flex-col gap-3 border-y border-slate-200 py-3 text-xs dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-2.5">
          <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center border border-slate-300 text-[9px] text-slate-500 dark:border-slate-700">
            i
          </span>
          <div>
            <p class="font-medium text-slate-800 dark:text-slate-200">Estás editando como invitado.</p>
            <p class="mt-0.5 text-[10px] text-slate-500 dark:text-slate-400">
              Tus cambios se conservan mientras esta sesión permanezca abierta.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <ValidationHints client:load compact />
          <a href="/login" class="flex items-center gap-1 self-start font-medium text-slate-800 hover:underline dark:text-slate-200 sm:self-auto">
            Iniciar sesión para guardar en la nube <span aria-hidden="true">↗</span>
          </a>
        </div>
      </footer>
    </main>
  </body>
</html>
